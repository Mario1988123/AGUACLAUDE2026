  "5_huella_columnas_explicitas": {
   "sql": "select 'product_attributes_cols_explicitas' t, count(*) n, md5(coalesce(string_agg(md5(row(x.id, x.name, x.category_id, x.key, x.data_type, x.unit, x.enum_values, x.sort_order, x.cloned_from_global_id)::text), '' order by id), '')) h\n from product_attributes x where company_id = 'f02d586c-0dc6-49e4-83e5-e0f6e688237c'\nunion all select 'product_compatibilities_cols_explicitas', count(*), md5(coalesce(string_agg(md5(row(x.id, x.company_id, x.spare_part_product_id, x.equipment_product_id, x.notes, x.created_at)::text), '' order by id), ''))\n from product_compatibilities x where company_id = 'f02d586c-0dc6-49e4-83e5-e0f6e688237c'\nunion all select 'catalog_products_total', count(*), md5(coalesce(string_agg(md5(x::text), '' order by id), '')) from catalog_products x\n",
