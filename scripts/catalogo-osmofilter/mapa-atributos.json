  "atributos": {
    "Altura dispensación (d)": {
      "transformacion": "numero",
      "destino": {
        "*": "dispenser_dispense_height_mm"
      }
    },
    "Dimensión Fondo (c')": {
      "transformacion": "numero",
      "destino": {
        "*": "horeca_depth_alt_mm"
      },
      "nota": "Solo Horeca: segundo fondo (c'). Qué mide exactamente [sin verificar]; mirar medidas.webp."
    },
    "Diametro del tanque": {
      "transformacion": "numero",
      "destino": {
        "*": "osmosis_tank_diameter_mm"
      }
    },
    "Alimentación eléctrica": {
      "transformacion": "texto",
      "destino": {
        "*": "common_power_supply"
      },
      "nota": "Es un rango (220-240V~50/60Hz): no se parte en dispenser_voltage_v y _frequency_hz."
    },
    "Potencia calentamiento": {
      "transformacion": "numero",
      "destino": {
        "*": "dispenser_heating_power_w"
      }
    },
    "Potencia enfriamiento": {
      "transformacion": "numero",
      "destino": {
        "*": "dispenser_cooling_power_w"
      }
    },
    "Potencia total": {
      "transformacion": "numero",
      "destino": {
        "dispensers": "dispenser_power_total_w",
        "horeca": "dispenser_power_total_w",
        "ozone": "ozone_power_w",
        "*": "common_power_total_w"
      }
    },
    "Aireador": {
      "transformacion": "texto",
      "destino": {
        "*": "tap_aerator"
      }
    },
    "Bandeja drenaje": {
      "transformacion": "booleano",
      "destino": {
        "*": "common_drip_tray"
      }
    },
    "Bloqueo mantenimiento": {
      "transformacion": "booleano",
      "destino": {
        "*": "osmosis_maintenance_lock"
      }
    },
    "Bypass incluido": {
      "transformacion": "booleano",
      "destino": {
        "*": "softener_bypass_integrated"
      }
    },
    "Conectividad": {
      "transformacion": "booleano",
      "destino": {
        "*": "common_connectivity"
      },
      "nota": "No se reutiliza softener_wifi_app: Osmofilter no dice que sea WiFi/App."
    },
    "Cuentalitros": {
      "transformacion": "booleano",
      "destino": {
        "*": "horeca_flow_meter"
      }
    },
    "Dispensación libre": {
      "transformacion": "booleano",
      "destino": {
        "*": "horeca_free_dispense"
      }
    },
    "Dispensación programable": {
      "transformacion": "booleano",
      "destino": {
        "*": "horeca_programmable_dispense"
      }
    },
    "Doble boya": {
      "transformacion": "booleano",
      "destino": {
        "*": "dispenser_double_float"
      }
    },
    "Doble programación dispensación": {
      "transformacion": "booleano",
      "destino": {
        "*": "horeca_dual_program_dispense"
      }
    },
    "Hidrogenador": {
      "transformacion": "booleano",
      "destino": {
        "*": "osmosis_hydrogenator"
      }
    },
    "Instalación cabinet": {
      "transformacion": "booleano",
      "destino": {
        "*": "horeca_cabinet_install"
      }
    },
    "Mantenimiento": {
      "transformacion": "texto",
      "destino": {
        "*": "common_maintenance_alert"
      }
    },
    "Mezclador dureza": {
      "transformacion": "texto",
      "destino": {
        "*": "softener_hardness_mixer"
      }
    },
    "Mixing agua": {
      "transformacion": "texto",
      "destino": {
        "*": "osmosis_water_mixing"
      }
    },
    "Panel Deco": {
      "transformacion": "booleano",
      "destino": {
        "*": "horeca_deco_panel"
      }
    },
    "Pantalla LCD": {
      "transformacion": "booleano",
      "destino": {
        "*": "common_lcd_display"
      }
    },
    "Posicionador botellas": {
      "transformacion": "booleano",
      "destino": {
        "*": "horeca_bottle_positioner"
      }
    },
    "Post-tratamiento": {
      "transformacion": "texto",
      "destino": {
        "*": "common_post_treatment"
      }
    },
    "Protección anti-fugas": {
      "transformacion": "texto",
      "destino": {
        "*": "common_leak_protection"
      }
    },
    "Regeneración": {
      "transformacion": "enum",
      "destino": {
        "*": "softener_regen_type"
      },
      "valores": {
        "Volumétrica": "volumétrica",
        "Cronométrica": "cronométrica"
      }
    },
    "Reset": {
      "transformacion": "booleano",
      "destino": {
        "*": "common_reset"
      }
    },
    "Resina": {
      "transformacion": "texto",
      "destino": {
        "*": "softener_resin_brand"
      }
    },
    "Sensor sal": {
      "transformacion": "booleano",
      "destino": {
        "*": "softener_salt_sensor"
      }
    },
    "Sistema ECO": {
      "transformacion": "booleano",
      "destino": {
        "*": "common_eco_system"
      }
    },
    "Tubing grifo": {
      "transformacion": "texto",
